@using AfricanIdeas.Services
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService Auth

<div class="d-flex">

    <!-- Sidebar -->
    <div class="sidebar bg-light p-3" style="width:200px; min-height:100vh;">
        <h4>Menu</h4>
        <ul class="nav flex-column">
            <li class="nav-item mb-1">
                <a class="nav-link" @onclick="@(() => NavigateTo("/login"))">Login</a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link" @onclick="@(() => NavigateTo("/register"))">Register</a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link" @onclick="@(() => NavigateTo("/courses"))">Courses</a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link" @onclick="@(() => NavigateTo("/mycourses"))">My Courses</a>
            </li>
        </ul>
    </div>

    <!-- Main content -->
    <div class="main-content flex-grow-1 p-3" style="margin-left:210px;">
        @Body
    </div>

</div>

@code {
    void NavigateTo(string url)
    {
        Nav.NavigateTo(url);
    }
}
